!infrastructure/
!infrastructure/spark/
!infrastructure/spark/hadoop-cli-log4j.properties
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.pyc
**/*.pyo
