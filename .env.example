# ============================================================
# WAREHOUSE BIG DATA PROJECT
# Environment: Local development (WSL2 + Docker Compose)
# Public template: keep machine-specific identities and credentials empty.
# ============================================================

# ------------------------------------------------------------
# Application Runtime
# ------------------------------------------------------------
WAREHOUSE_ENV=local
WAREHOUSE_LOG_LEVEL=INFO

# ------------------------------------------------------------
# Hadoop HDFS
# ------------------------------------------------------------
# Set an endpoint reachable from the caller in the local .env.
# Container-network example: hdfs://hdfs-namenode:8020 (requires Docker service DNS).
WAREHOUSE_HDFS_URI=
WAREHOUSE_HDFS_BASE_PATH=/data/warehouse

# ------------------------------------------------------------
# Apache Spark Standalone
# ------------------------------------------------------------
# Set an endpoint reachable from the caller in the local .env.
# Container-network example: spark://spark-master:7077 (requires Docker service DNS).
WAREHOUSE_SPARK_MASTER_URL=

# ------------------------------------------------------------
# ClickHouse (not deployed by the current project)
# ------------------------------------------------------------
WAREHOUSE_CLICKHOUSE_HOST=
WAREHOUSE_CLICKHOUSE_PORT=
WAREHOUSE_CLICKHOUSE_DATABASE=
WAREHOUSE_CLICKHOUSE_USER=
WAREHOUSE_CLICKHOUSE_PASSWORD=

# ------------------------------------------------------------
# Local Artifacts & Scratch Storage
# ------------------------------------------------------------
WAREHOUSE_ARTIFACTS_DIR=artifacts
WAREHOUSE_SCRATCH_DIR=artifacts/scratch

# ------------------------------------------------------------
# M5 Dataset — Live Integration Testing
# ------------------------------------------------------------
# Set the actual local source location, for example ./data/m5/source, in .env.
WAREHOUSE_M5_SOURCE_DIR=
# Supply the actual provenance URL, for example:
# https://www.kaggle.com/competitions/m5-forecasting-accuracy/data
WAREHOUSE_M5_SOURCE_URL=
# Supply only the actual source acquisition timestamp, if known.
WAREHOUSE_M5_DOWNLOADED_AT_UTC=

# ------------------------------------------------------------
# Canonical M5 Small artifacts (local JSON path, not an HDFS URI)
# ------------------------------------------------------------
WAREHOUSE_SMALL_ARTIFACTS=artifacts/small-artifacts.json
# Only for separately authorized serial live acceptance; never inferred by integration tests.
WAREHOUSE_SMALL_STAGES=

# ------------------------------------------------------------
# Retired selectors: retained empty for environment migration only; no runner reads them.
# ------------------------------------------------------------
# Use WAREHOUSE_SMALL_ARTIFACTS instead. The full-catalog smoke workflow is retired.
WAREHOUSE_M04_PERFORMANCE=0
WAREHOUSE_M04_SOURCE_VERSION=
WAREHOUSE_M05_SOURCE_VERSION=
WAREHOUSE_M05_SOURCE_SNAPSHOT_ID=
WAREHOUSE_M05_UPSTREAM_PIPELINE_RUN_ID=

# ============================================================
# END OF CONFIGURATION
# ============================================================
