# Runtime mode and logging. Supported modes are local, test, and container.
WAREHOUSE_ENV=local
WAREHOUSE_LOG_LEVEL=INFO

# Host-side HDFS/integration clients require an explicitly supplied runtime endpoint.
# Canonical container-internal endpoint: hdfs://hdfs-namenode:8020
# Use it only where hdfs-namenode resolves; host-side clients cannot assume Docker service DNS.
# Compose services keep their own explicit internal endpoint and do not read this file.
WAREHOUSE_HDFS_URI=
WAREHOUSE_HDFS_BASE_PATH=/data/warehouse

# Host-side Spark/integration clients use this value. Spark infrastructure is opt-in:
# bash scripts/spark-cluster.sh up (requires 10 GiB Docker memory).
# Container-internal Standalone endpoint: spark://spark-master:7077; requires Docker service DNS.
# Supply the endpoint explicitly to future clients; local[*] still selects a local runtime.
# The Compose submission service retains its own explicit internal endpoint.
WAREHOUSE_SPARK_MASTER_URL=

# ClickHouse is not deployed by the current repository. Required connection fields are blank.
# Example host and port: clickhouse-1 and 8123
WAREHOUSE_CLICKHOUSE_HOST=
WAREHOUSE_CLICKHOUSE_PORT=
WAREHOUSE_CLICKHOUSE_DATABASE=
WAREHOUSE_CLICKHOUSE_USER=
# Keep this empty for local unauthenticated development; never commit a real secret here.
WAREHOUSE_CLICKHOUSE_PASSWORD=

# This is a local filesystem path, not an HDFS path. The directory is not created by loading.
WAREHOUSE_ARTIFACTS_DIR=artifacts

# Disk-backed, writable Ubuntu-local scratch for SQLite profiling indexes and bounded temp files.
# The M03 launcher defaults this to artifacts/scratch and verifies it before starting Python.
WAREHOUSE_SCRATCH_DIR=artifacts/scratch

# Optional source inputs for the host ingestion wrapper and opt-in integration checks.
# Keep the source path blank in this tracked template; set machine-specific values only in .env.
WAREHOUSE_M5_SOURCE_DIR=
WAREHOUSE_M5_SOURCE_URL=
WAREHOUSE_M5_DOWNLOADED_AT_UTC=
