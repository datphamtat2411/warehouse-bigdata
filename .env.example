# Runtime mode and logging. Supported modes are local, test, and container.
WAREHOUSE_ENV=local
WAREHOUSE_LOG_LEVEL=INFO

# HDFS requires an explicitly supplied runtime endpoint reachable from the client.
# Canonical container-internal endpoint: hdfs://hdfs-namenode:8020
# Use it only where hdfs-namenode resolves; host-side clients cannot assume Docker service DNS.
WAREHOUSE_HDFS_URI=
WAREHOUSE_HDFS_BASE_PATH=/data/warehouse

# Spark is not deployed by the current repository. Use local[*] for a local Spark runtime.
# Example standalone syntax: spark://spark-master:7077
WAREHOUSE_SPARK_MASTER_URL=

# ClickHouse is not deployed by the current repository. Required connection fields are blank.
# Example host and port: clickhouse-1 and 8123
WAREHOUSE_CLICKHOUSE_HOST=
WAREHOUSE_CLICKHOUSE_PORT=
WAREHOUSE_CLICKHOUSE_DATABASE=
WAREHOUSE_CLICKHOUSE_USER=
# Keep this empty for local unauthenticated development; never commit a real secret here.
WAREHOUSE_CLICKHOUSE_PASSWORD=

# This is a local filesystem path, not an HDFS path. The directory is not created by loading.
WAREHOUSE_ARTIFACTS_DIR=artifacts
